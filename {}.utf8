  </head>
  <body onload="MM_preloadImages(images/en/savoirs_r.gif,images/en/langue_r.gif,images/en/recherche_r.gif)" style="background-color: white;" topmargin="0" marginwidth="0" marginheight="0" leftmargin="0">
    
    <!-- HEADER BANNER -->
    <table width="100%" cellspacing="0" cellpadding="0" border="0">
      <tbody>
        <tr bgcolor="#FF9900">
          <td height="80" valign="top">
            <div align="center"><img src="images/bandeaueng.jpg" height="80" width="774"></div>
          </td>
        </tr>
        <tr bgcolor="#336699">
          <td height="24" valign="top"><img src="/images/bleu.gif" height="24" width="344" border="0">
            <img src="/images/bleu.gif" height="24" width="30">
