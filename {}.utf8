          <td height="600" width="185" valign="top" bgcolor="#FFCC99">
            <p align="center">&nbsp;</p>
            <p>&nbsp;</p>
            <p>&nbsp;</p>
            <p>&nbsp;</p>
            <p>&nbsp;</p>
            <p>&nbsp;</p>
            
            <!-- MENU ITEMS -->
            <p class="menu1" align="left">
              <img src="images/puce.gif" height="12" width="26" align="top">
              <a href="en/demarch/demarch.htm">Approach</a>
            </p>
