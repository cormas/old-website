        <tbody>

          <tr>

            <td style="text-align: center;"></td>

            <td style="text-align: center;"><span style="" lang="PT-BR">GainsMin</span></td>

            <td style="text-align: center;"><span style="" lang="PT-BR">GainsMax</span></td>

            <td style="text-align: center;"><span style="" lang="PT-BR">P&eacute;riode N</span></td>

            <td style="text-align: center;"><span style="" lang="EN-US">Phase </span>&phi;</td>

          </tr>

          <tr>

            <td style="text-align: center;"><span style="" lang="EN-US">Soja</span></td>

            <td style="text-align: center;"><span style="" lang="EN-US">48760</span></td>

            <td style="text-align: center;"><span style="" lang="EN-US">79580</span></td>

