<body  marginwidth="0" marginheight="0" topmargin="0" leftmargin="0" border="0" bgcolor="#FFFFFF">
<!--#include virtual="haut.inc" -->
<table cellspacing="0" cellpadding="0" border="0" width="100%">
<tr>
    <!--#include virtual="sommair.inc" --> 
    <td width="*" valign="top" bgcolor="#FFFFFF"> 
      <p>
      <h1>Downloading Cormas</h1>
      <h2>&nbsp;</h2>
      <h2>&nbsp;</h2>
      <p>If you have never installed CORMAS, please click <a href="http://www.cincom.com/scripts/smalltalk.dll//downloads/index.ssp?content=visualworks"><strong>here</strong></a> to download VisualWork. </p>
      <p>To download CORMAS parcel please click <a href="../../logiciel/cormas2004/parcelCormas.zip"><strong>here<img src="../../images/zip.gif" width="27" height="28">.</strong></a></p>
      <p>To see how to install CORMAS please click <a href="../../logiciel/Cormas-Installation-version1.4.zip"><strong>here<img src="../../images/ppt.gif" width="28" height="25"></strong></a>.   </p>
      <p>&nbsp;</p>
      <p>&nbsp;</p>
      <p>&nbsp;</p>
      <p>&nbsp;</p>
      <p>&nbsp;</p>
      <p>&nbsp;</p>
      <!--#include virtual="/include/copyright_en.inc" --> </td>
    <td width="15" valign="top" bgcolor="#FFFFFF"> 
    <div align="right" class="texte"></div>
    </td>
  </tr>
</table>
</body>
