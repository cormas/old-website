            </td>
            <td width="152"> 
              <div align="center"><font color="#000000"><b>correction</b></font></div>
            </td>
          </tr>
          <tr> 
            <td width="85">06, june 2002</td>
            <td width="423" nowrap>lengend problem</td>
            <td width="90">Pierre</td>
