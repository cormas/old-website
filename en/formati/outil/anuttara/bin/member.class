		function lookupEmail($email){
			$query_lookup="select email, firstname as fname, middlename as mname, lastname as lname from ".$this->tMember." where email like '".$email."';";
			$result_lookup=mysql_query($query_lookup);
			$total=mysql_numrows($result_lookup);
			//Current user
			if($total!=0){
			  //echo "<p>Hello ".mysql_result($result_lookup,0, "fname")." ".mysql_result($result_lookup,0, "mname")." ".mysql_result($result_lookup,0, "lname").",<br>";
			  return true;
			}
			//New user
			else if ($total==0){
			  echo "<center><b>(^_^) Welcome new member.</center>";
			  return false; 		
			}
		}

		function lookupinSubscribe(){
			$query_lookup="select member.member_id as id, subscribe.unsubscribe as unsubscribe, subscribe.level_interest1 as level_interest1, subscribe.level_interest2 as level_interest2, subscribe.level_interest3 as level_interest3 from subscribe, member where subscribe.member_id=member.member_id and member.member_id ='".$this->id."';";
			//echo "<p>lookupsubscribe=".$query_lookup."<br>";
			$result_lookup=mysql_query($query_lookup);
			$total=mysql_numrows($result_lookup);
			//Current user
			if($total!=0 && mysql_result($result_lookup,0, "unsubscribe")==0){
			  $this->retriveData();
			  echo "<center><b><font color ='green'>You have subscribed.</font></center>";

				$this->interest_level1=mysql_result($result_lookup,0, "level_interest1");
				$this->interest_level2=mysql_result($result_lookup,0, "level_interest2");
				$this->interest_level3=mysql_result($result_lookup,0, "level_interest3");

			  return 1;
			}
			if($total!=0 && mysql_result($result_lookup,0, "unsubscribe")==1){
			  $this->retriveData();
			  echo "<center><b><font color ='red'>You have un-subscribed.</font></center>";
			  echo "<p>Hello ".$this->fname." ".$this->mname." ".$this->lname.",<br>";
				$this->interest_level1=mysql_result($result_lookup,0, "level_interest1");
				$this->interest_level2=mysql_result($result_lookup,0, "level_interest2");
				$this->interest_level3=mysql_result($result_lookup,0, "level_interest3");

			  return 2;
			}
			//New user or the user has downloaded.
			else if ($total==0){
			  //To Lookup in Download
			  //echo "<center><b>(^_^) Welcome new member.</center>";
			  return 3; 		
			}
		}
		function lookupinDownload(){
			$query_lookup="select member.member_id, download.purpose_id as purpose, download.purpose_remarks, download.download_date as download_date from download, member where member.member_id=download.member_id and member.member_id ='".$this->id."' order by download_date DESC limit 1;";//Only the recently date
			//echo "<p>lookupdownload=".$query_lookup."<br>";
			$result_lookup=mysql_query($query_lookup);
			$total=mysql_numrows($result_lookup);
			//Current user
			if($total!=0){
			  $this->retriveData();
			  echo "<center><b><font color ='green'>You have downloaded.</font></center>";
			  //echo "<p>Hello ".$this->fname." ".$this->mname." ".$this->lname.",<br>";
			  //echo "<p>ID=".$this->id."<br>";

				$this->download_date=mysql_result($result_lookup,0, "download_date");
				$this->purpose=mysql_result($result_lookup,0, "purpose");
				$this->purpose_remarks=mysql_result($result_lookup,0, "purpose_remarks");
			  return 1;
			}
			//New user
			else if ($total==0){
			  //To Lookup in Download
			  //echo "<center><b>(^_^) Welcome new member.</center>";
			  return 0; 		
			}
		}


		function retriveData(){
			$query_lookup="select member_id, firstname as fname, middlename as mname, lastname as lname,email, institute_company as company, company_type, city, country_id, know_id, interest_research_area, language_id, register_date, update_date, userkey from ".$this->tMember."  where email like '".$this->email."';";
			$result_lookup=mysql_query($query_lookup);
			$total=mysql_numrows($result_lookup);

			$this->id=mysql_result($result_lookup,0, "member_id");
			$this->fname=mysql_result($result_lookup,0, "fname");
			$this->mname=mysql_result($result_lookup,0, "mname");
			$this->lname=mysql_result($result_lookup,0, "lname");
			$this->email=mysql_result($result_lookup,0, "email");
			$this->country=mysql_result($result_lookup,0, "country_id");
			$this->company=mysql_result($result_lookup,0, "company");
			$this->know=mysql_result($result_lookup,0, "know_id");
			$this->interest=mysql_result($result_lookup,0, "interest_research_area");
			$this->language=mysql_result($result_lookup,0, "language_id");
			$this->city=mysql_result($result_lookup,0, "city");		
			$this->userkey=mysql_result($result_lookup,0, "userkey");		
		}

		function checkDuplicateEmail(){
			$query_lookup="select member_id from ".$this->tMember."  where email like '".$this->email."' and member_id!='".$this->id."';";
			//echo "----->retrieveID".$query_lookup;
			$result_lookup=mysql_query($query_lookup);
			$total=mysql_numrows($result_lookup);
			if($total!=0){
				return 1;
			}
			else{
				return 0;
			}
		}

		function retrieveMemberID(){
			$query_lookup="select member_id from ".$this->tMember."  where email like '".$this->email."';";
			//echo "----->retrieveID".$query_lookup;
			$result_lookup=mysql_query($query_lookup);
			$total=mysql_numrows($result_lookup);
			if($total!=0){
				$this->id=mysql_result($result_lookup,0, "member_id");
			}
		}

		function AddNewProfile(){
			$this->register_date=date("Y-m-d");

			$str1= "insert into ".$this->tMember."(register_date, firstname, middlename, lastname, email, institute_company, city, country_id, interest_research_area, know_id, language_id) values ('".$this->register_date."', '".$this->fname."', '".$this->mname."', '".$this->lname."', '".$this->email."','".$this->company."', '". $this->city."', '". $this->country."', '". $this->interest."', '". $this->know."', '". $this->language."');";
			//echo $str1."<br>";

			$result=mysql_query($str1);
			if($result)
				mysql_affected_rows();
		}

		function AddNewSubscribe(){
			$this->update_date=date("Y-m-d");

			$insertInterests="insert into subscribe (member_id,level_interest1, level_interest2, level_interest3, subscribe_date) values ('".$this->id."','".$this->interest_level1."' ,'".$this->interest_level2."', '".$this->interest_level3."','".$this->update_date."');";

			//echo "insertInterests=>".$insertInterests."<br>";

			$result=mysql_query($insertInterests);// To update the profile.
			if($result)
				mysql_affected_rows();
		}

		function AddNewDownload(){
			$this->update_date=date("Y-m-d");

			$insertInterests="insert into download (member_id,download_date, purpose_id, purpose_remarks) values ('".$this->id."','".$this->update_date."' ,'".$this->purpose."', '".$this->purpose_remarks."');";

			//echo "insertInterests=>".$insertInterests."<br>";

			$result=mysql_query($insertInterests);// To update the profile.
			if($result)
				mysql_affected_rows();
		}

		function updateProfile(){
			$this->update_date=date("Y-m-d");

			$updateUserProfile="update ".$this->tMember." set firstname='".$this->fname."', middlename='".$this->mname."', lastname='".$this->lname."', email='".$this->email."', institute_company='".$this->company."', city='".$this->city."', country_id='".$this->country."', know_id='".$this->know."', interest_research_area='".$this->interest."', validated='1', update_date='".$this->update_date."' where member_id like '".$this->id."';";

			//echo "updateUserProfile=>".$updateUserProfile."<br>";

			$result=mysql_query($updateUserProfile);// To update the profile.
			if($result){
				mysql_affected_rows();
//				echo "<br>Your information is updated. <br> Thank you :) ".$fname." ".$mname." ".$lname."<br>";
			}
			else{
				echo "<br>The email address is duplicated. Please use another email address.<br>";
				echo "<a href = 'javascript:history.back()'> Back :) </a> ";
			}
			//mysql_close();
		}

		function updateSubscribe(){
			$this->update_date=date("Y-m-d");

			$updateInterests="update subscribe set unsubscribe ='0', level_interest1 ='".$this->interest_level1."', level_interest2 ='".$this->interest_level2."', level_interest3 ='".$this->interest_level3."' , 'unsubscribe_date='".$this->update_date."'  where member_id like '".$this->id."';";

			//echo "updateInterests=>".$updateInterests."<br>";

			$result=mysql_query($updateInterests);// To update the profile.
			if($result){
				mysql_affected_rows();
			}
			//mysql_close();
		}

		function setUnSubscribe(){
			$this->update_date=date("Y-m-d");

			$updateInterests="update subscribe set unsubscribe ='1', unsubscribe_date='".$this->update_date."' where member_id like '".$this->id."';";

			//echo "updateInterests=>".$updateInterests."<br>";

			$result=mysql_query($updateInterests);// To update the profile.
			if($result){
				mysql_affected_rows();
			}
			//mysql_close();
		}
		function myCheckDNSRR($hostName, $recType = '') 
		{ 
		 if(!empty($hostName)) { 
		   if( $recType == '' ) $recType = "MX"; 
		   exec("nslookup -type=$recType $hostName", $result); 
		   // check each line to find the one that starts with the host 
		   // name. If it exists then the function succeeded. 
		   foreach ($result as $line) { 
		     if(eregi("^$hostName",$line)) { 
		       return 1; 
		     } 
		   } 
		   // otherwise there was no mail handler for the domain 
		   return 0; 
		 } 
		 return 0; 
		}		
	}
