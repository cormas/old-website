	class Report extends DB{

	   var $starting_date;
	   var $ending_date;
	   
	   var $from;
	   var $to;

	   var $date1;
	   var $date2;
	   
	   var $month1;
	   var $month2;
	   
	   var $year1;
	   var $year2;
	   
	   var $title;
	   var $type;
	   var $sql_datasource;

	   var $country_desc;
	   var $m= array(31,28,31,30,31,30,31,31,30,31,30,31);

		function showValue(){
			echo ", Starting_date=".$this->starting_date;
			echo ", Ending_date=".$this->ending_date;
			echo ", Title=".$this->title;
			echo ", Type=".$this->type;

		}
		function getMonth($m){
			$month_en=array('','January','February','March','April','May','June','July','August','September','October','November','December');
			return $month_en[$m+0];
		}
		function compareDate(){
			$temp;
			if($this->starting_date > $this->ending_date){
				$temp = $this->ending_date;
				$this->ending_date=$this->starting_date;
				$this->starting_date=$temp;
			}
		}

		function LookupCountry($country_id){
			 $query_lookup = "select c.clause as country_desc "
					."from country ct, clause c, sysDictionary s, "
					."language l where c.clause_id=s.clause_id "
					."and ct.country_clause_set=s.clause_set "
					."and l.language_id=c.language_id "
					."and l.language_id like '2' and ct.country_id like '".$country_id."' ";
	 		 $result_lookup=mysql_query($query_lookup);
			 $total=mysql_numrows($result_lookup);
                         
			 if($total!=0){
			  $this->country_desc=mysql_result($result_lookup,0, "country_desc");
			}
		}

		function LastDateofMonth($month,$year){
			if ($month != 2) return $this->m[$month - 1];
			if ($year%4 != 0) return $this->m[1];
			if ($year%100 == 0 && $year%400 != 0) return $this->m[1];
			return $this->m[1] + 1;
		}

	}//end class Report

